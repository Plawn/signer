FROM clux/muslrust:stable AS chef
USER root
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json --bin signer

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json
RUN apt install musl-dev musl-tools -y
# Notice that we are specifying the --target flag!
RUN cargo chef cook --release --target x86_64-unknown-linux-musl --recipe-path recipe.json
COPY . .

RUN cargo build --release --target x86_64-unknown-linux-musl --bin signer

FROM alpine AS runtime
# RUN addgroup -S myuser && adduser -S myuser -G myuser
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/signer /usr/local/bin/signer
# USER myuser
CMD ["/usr/local/bin/signer"]